# -----------------------------
# PostgreSQL
# -----------------------------
DB_URL=jdbc:postgresql://db:5432/gpsdb
DB_USERNAME=gpsvariant
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# -----------------------------
# Public application URL
# Must be HTTPS in production.
# -----------------------------
APP_BASE_URL=https://gpsvariant.example.com
SERVER_PORT=8080
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=30m

# -----------------------------
# Persistent uploads
# -----------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB

# -----------------------------
# Google Static Maps
# -----------------------------
GOOGLE_MAPS_API_KEY=CHANGE_ME

# -----------------------------
# Password reset email / SMTP
# -----------------------------
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
PASSWORD_RESET_EXPIRY_MINUTES=15
PASSWORD_RESET_CLEANUP_MS=3600000

# -----------------------------
# Production JPA
# Use validate after the database schema has been created.
# For the first deployment, update can be used if required.
# -----------------------------
JPA_DDL_AUTO=validate

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
